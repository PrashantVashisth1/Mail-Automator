PORT=5001
MONGO_URI=

# Where the API and the web app run. Used for the Google redirect and for cookies.
# In production set BOTH to the Vercel URL (Vercel forwards /api to this server).
SERVER_URL=http://localhost:5001
CLIENT_URL=http://localhost:5173

# Google OAuth client (Google Cloud Console -> Google Auth Platform -> Clients -> Web application).
# Authorized redirect URI must be: <SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET signs the login cookie. TOKEN_ENCRYPTION_KEY (64 hex chars) encrypts Google tokens in MongoDB.
# Changing TOKEN_ENCRYPTION_KEY later means every user must sign in again.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Max successful emails per user per day (resets at midnight IST).
DAILY_SEND_LIMIT=50

# Seconds between emails when sending a CSV in bulk. On Vercel use 60 (the cron runs once a minute).
BULK_GAP_SECONDS=45

# Only for serverless hosting (Vercel): secret for /api/bulk/tick, called every minute by an
# external cron with the header "Authorization: Bearer <CRON_SECRET>". Generate like JWT_SECRET.
CRON_SECRET=

# true = don't really send anything, just log to the console (for testing).
MAIL_DRY_RUN=false
